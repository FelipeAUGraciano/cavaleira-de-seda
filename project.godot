; Engine configuration file.
; Cavaleira de Seda — protótipo cinza (Godot 4.7)

config_version=5

[application]

config/name="Cavaleira de Seda"
config/description="Protótipo cinza: sobrevivência e estratégia top-down numa caverna."
run/main_scene="res://world/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
WebNetwork="*res://autoload/web_network.gd"
Voice="*res://autoload/voice.gd"
World="*res://autoload/world.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="jogadora"
3d_physics/layer_3="criaturas"
3d_physics/layer_4="fio"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
